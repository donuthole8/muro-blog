# このファイルを .env としてコピーして使う。
# .env は ADMIN_TOKEN 等を含むため gitignore 対象（コミットしない）。
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       environment-specific defaults（同じく gitignore 対象）
#  * .env.$APP_ENV.local uncommitted environment-specific overrides

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# compose.yaml のローカル Postgres に合わせた既定値
DATABASE_URL="postgresql://blog:blog@127.0.0.1:5433/blog?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app ###
# 管理 API の共有シークレット。本番では必ず別の値に差し替えること。
ADMIN_TOKEN=dev-local-token
###< app ###
