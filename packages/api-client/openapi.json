    "components": {
        "schemas": {
            "PostInput": {
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "\u306f\u3058\u3081\u3066\u306e\u8a18\u4e8b",
                        "default": "",
                        "maxLength": 255
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "[a-z0-9]+(?:-[a-z0-9]+)*",
                        "example": "hello-world",
                        "default": "",
                        "maxLength": 128
                    },
                    "emoji": {
                        "title": "null \u306a\u3089\u65e2\u5b9a\u306e\u7d75\u6587\u5b57\u304c\u5165\u308b\u3002",
                        "description": "\u8a18\u4e8b\u306e\u30a2\u30a4\u30ad\u30e3\u30c3\u30c1\u7d75\u6587\u5b57",
                        "type": "string",
                        "example": "\ud83d\udcdd",
                        "nullable": true,
                        "maxLength": 8
                    },
                    "bodyMd": {
                        "description": "Markdown \u539f\u6587",
                        "type": "string",
                        "example": "# \u898b\u51fa\u3057\n\n\u672c\u6587\u3002",
                        "default": ""
                    },
                    "excerpt": {
                        "title": "null \u306a\u3089\u672c\u6587\u304b\u3089\u81ea\u52d5\u751f\u6210\u3059\u308b\u3002",
                        "description": "\u672a\u6307\u5b9a\u306a\u3089\u672c\u6587\u304b\u3089\u81ea\u52d5\u751f\u6210\u3055\u308c\u308b",
                        "type": "string",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "tagSlugs": {
                        "title": "\u4ed8\u4e0e\u3059\u308b\u30bf\u30b0\u306e slug\u3002\u65e2\u5b58\u306e\u30bf\u30b0\u306e\u307f\u6307\u5b9a\u3067\u304d\u308b\u3002\n\u65b0\u3057\u3044\u30bf\u30b0\u306f POST /api/admin/tags \u3067\u5148\u306b\u4f5c\u6210\u3059\u308b\u3053\u3068\n\uff08\u65e5\u672c\u8a9e\u306e\u30bf\u30b0\u540d\u304b\u3089 slug \u3092\u6a5f\u68b0\u7684\u306b\u5c0e\u51fa\u3067\u304d\u306a\u3044\u305f\u3081\uff09\u3002",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "php",
                            "symfony"
                        ],
                        "default": []
                    }
                },
                "type": "object"
            },
            "MarkdownPreviewInput": {
                "properties": {
                    "bodyMd": {
                        "description": "\u30d7\u30ec\u30d3\u30e5\u30fc\u3057\u305f\u3044 Markdown \u539f\u6587",
                        "type": "string",
                        "example": "# \u898b\u51fa\u3057\n\n\u672c\u6587\u3002",
                        "default": "",
                        "maxLength": 200000
                    }
                },
                "type": "object"
            },
            "TagInput": {
                "properties": {
                    "name": {
                        "title": "\u8868\u793a\u540d\u3002\u65e5\u672c\u8a9e\u3082\u4f7f\u3048\u308b\u3002",
                        "type": "string",
                        "example": "JavaScript",
                        "default": "",
                        "maxLength": 64
                    },
                    "slug": {
                        "title": "URL \u306b\u4f7f\u3046\u8b58\u5225\u5b50\u3002\u65e5\u672c\u8a9e\u540d\u304b\u3089\u6a5f\u68b0\u7684\u306b\u5c0e\u51fa\u3067\u304d\u306a\u3044\u305f\u3081\u660e\u793a\u7684\u306b\u6307\u5b9a\u3059\u308b\u3002",
                        "type": "string",
                        "pattern": "[a-z0-9]+(?:-[a-z0-9]+)*",
                        "example": "javascript",
                        "default": "",
                        "maxLength": 64
                    }
                },
                "type": "object"
            },
            "TagSummary": {
                "required": [
                    "name",
                    "slug"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "JavaScript"
                    },
                    "slug": {
                        "type": "string",
                        "example": "javascript"
                    }
                },
                "type": "object"
            },
            "PostAdminSummary": {
                "required": [
                    "id",
                    "slug",
                    "title",
                    "status",
                    "updatedAt",
                    "tags"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "emoji": {
                        "type": "string",
                        "example": "\ud83d\udcdd",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "example": "draft",
                        "enum": [
                            "draft",
                            "published"
                        ]
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TagSummary"
                        }
                    }
                },
                "type": "object"
            },
            "PostAdminDetail": {
                "required": [
                    "id",
                    "slug",
                    "title",
                    "bodyMd",
                    "status",
                    "createdAt",
                    "updatedAt",
                    "tags"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "emoji": {
                        "type": "string",
                        "example": "\ud83d\udcdd",
                        "nullable": true
                    },
                    "bodyMd": {
                        "description": "Markdown \u539f\u6587",
                        "type": "string"
                    },
                    "excerpt": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "draft",
                            "published"
                        ]
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TagSummary"
                        }
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "\u5165\u529b\u5185\u5bb9\u306b\u8aa4\u308a\u304c\u3042\u308a\u307e\u3059\u3002"
                    },
                    "errors": {
                        "type": "object",
                        "example": {
                            "slug": "slug \u306f\u5fc5\u9808\u3067\u3059\u3002"
                        },
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            },
            "MarkdownPreview": {
                "required": [
                    "bodyHtml",
                    "excerpt"
                ],
                "properties": {
                    "bodyHtml": {
                        "description": "\u5909\u63db\u5f8c\u306e HTML",
                        "type": "string"
                    },
                    "excerpt": {
                        "description": "\u672c\u6587\u304b\u3089\u81ea\u52d5\u751f\u6210\u3057\u305f\u629c\u7c8b",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "PostSummary": {
                "required": [
                    "id",
                    "slug",
                    "title",
                    "tags"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string",
                        "example": "hello-world"
                    },
                    "title": {
                        "type": "string"
                    },
                    "emoji": {
                        "type": "string",
                        "example": "\ud83d\udcdd",
                        "nullable": true
                    },
                    "excerpt": {
                        "type": "string",
                        "nullable": true
                    },
                    "publishedAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-06T12:00:00+00:00",
                        "nullable": true
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TagSummary"
                        }
                    }
                },
                "type": "object"
            },
            "PaginatedPosts": {
                "required": [
                    "items",
                    "total",
                    "page",
                    "perPage",
