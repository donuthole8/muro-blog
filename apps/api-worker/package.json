{
  "name": "@blog/api-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/markdown-it": "^14.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@blog/api-client": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "markdown-it": "^15.0.2",
    "ulid": "^3.0.2"
  }
}
