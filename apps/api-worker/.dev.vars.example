# ローカル開発用。.dev.vars にコピーして使う（gitignore 対象）。
APP_ENV=dev
SITE_HOST=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/auth/callback
# 開発用ログイン（Google なしで任意の handle としてログインする）。APP_ENV=dev でしか効かない。
DEV_LOGIN_ENABLED=1
# 投稿の不適切さの判定（Jev）。https://console.typesafe.ai/ で発行。空なら判定しない
TYPESAFE_API_KEY=
# メール送信（Brevo, https://app.brevo.com/ で発行）。空なら送らず、確認・再設定のリンクを wrangler のログに出す
BREVO_API_KEY=
MAIL_FROM=
SITE_URL=http://localhost:3100
# Web Push の VAPID 鍵。`node scripts/generate-vapid-keys.mjs` で作る。空ならプッシュ通知を送らない
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
