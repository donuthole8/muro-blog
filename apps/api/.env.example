# このファイルを .env としてコピーして使う。
# .env は GOOGLE_CLIENT_SECRET 等を含むため gitignore 対象（コミットしない）。
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       environment-specific defaults（同じく gitignore 対象）
#  * .env.$APP_ENV.local uncommitted environment-specific overrides

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# compose.yaml のローカル Postgres に合わせた既定値
DATABASE_URL="postgresql://blog:blog@127.0.0.1:5433/blog?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app ###
# Google OAuth（Google Cloud Console の「認証情報」で OAuth クライアント ID を作る）。
# GOOGLE_REDIRECT_URI は Worker 側のコールバック。コンソールに登録した値と一字一句揃える。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/auth/callback

# 投稿本文のリンクのうち、新しいタブで開かない（自サイトとみなす）ホスト
SITE_HOST=localhost

# 開発用ログイン（Google なしで任意の handle としてログインする）。APP_ENV=dev でしか効かない。
DEV_LOGIN_ENABLED=1
###< app ###
