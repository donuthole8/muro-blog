# API（apps/api-worker）のベース URL。ローカル開発とビルド（プリレンダリング）で使う。
# ローカル: http://127.0.0.1:8000
# 本番ビルド: https://teatimes-api.muronaga.workers.dev
# デプロイ後の Worker はこれを使わず、Service Binding で API を呼ぶ（src/lib/api.ts）
API_BASE_URL=http://127.0.0.1:8000

# 公開サイトの URL。RSS・サイトマップ・OGP の絶対 URL に使う。
# https で始まるときだけセッション Cookie に Secure を付ける。
SITE_URL=http://localhost:3100
